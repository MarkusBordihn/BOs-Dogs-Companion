# Dog Commands
attack.success=%name% is attacking!
attack.no_target=No target found. Look at an entity to attack.
attack.invalid_target=Invalid attack target
follow.success=%name% is now following you
follow.re_triggered=%name% is already following - teleporting to you
follow.re_triggered.hint=If your dog is stuck, use /dog wait then /dog follow
name.success=Renamed %name% to %newName%!
play.success=%name% is playing!
sit.success=%name% is now sitting
sleep.success=%name% is sleeping
wait.success=%name% is now waiting
wander.success=%name% is now wandering freely

spawn.not_implemented=Spawn command is not yet implemented
spawn.no_match=No despawned dogs found matching '{filter}'
spawn.no_despawned=All your dogs are already spawned!
