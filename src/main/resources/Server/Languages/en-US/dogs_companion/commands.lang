list.none=You don't have any dogs yet

error.not_owner=%name% belongs to %owner%
error.no_dog=No dog found. Look at a dog and try again.
error.not_owned=This dog doesn't have an owner.
error.player_only=This command can only be used by players
error.no_uuid=Unable to get player UUID
error.player_pos_not_found=Unable to find your position
error.release_failed=Failed to release dog ownership
