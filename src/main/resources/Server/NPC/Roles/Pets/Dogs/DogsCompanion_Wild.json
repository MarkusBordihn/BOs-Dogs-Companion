{
  "Type": "Generic",
  "StartState": "Wild",
  "DefaultSubState": "Default",
  "Appearance": {
    "Compute": "Appearance"
  },
  "NameTranslationKey": {
    "Compute": "NameTranslationKey"
  },
  "DefaultNPCAttitude": "Ignore",
  "DefaultPlayerAttitude": "Neutral",
  "DeathAnimationTime": 1.5,
  "ApplySeparation": true,
  "SeparationDistance": 1,
  "SeparationWeight": 1,
  "KnockbackScale": 0.5,
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 6,
      "RunThreshold": 0.7,
      "RunThresholdRange": 0.1,
      "Gravity": 10,
      "MaxFallSpeed": 20,
      "Acceleration": 12,
      "DescentAnimationType": "Fall",
      "DescentSteepness": 2.5,
      "DescentBlending": 1,
      "JumpDescentSteepness": 8,
      "JumpHeight": 0.1,
      "MaxClimbHeight": 1
    }
  ],
  "MaxHealth": 40,
  "Instructions": [
    {
      "Instructions": [
        {
          "$Comment": "React to damage with hurt animation",
          "Continue": true,
          "Sensor": {
            "Type": "Damage"
          },
          "ActionsBlocking": true,
          "Actions": [
            {
              "Type": "PlayAnimation",
              "Animation": "Hurt",
              "Slot": "Status"
            },
            {
              "Type": "Timeout",
              "Delay": [0.5, 0.5]
            }
          ]
        },
        {
          "$Comment": "Dog is not tamed yet - wanders and seeks food",
          "Sensor": {
            "Type": "State",
            "State": "Wild"
          },
          "Instructions": [
            {
              "$Comment": "Default wild state - seek food or wander",
              "Sensor": {
                "Type": "State",
                "State": ".Default"
              },
              "Instructions": [
                {
                  "$Comment": "Follow player with CookedBeef or Bone in hand",
                  "Sensor": {
                    "Type": "Player",
                    "Range": 8,
                    "Filters": [
                      {
                        "Type": "ItemInHand",
                        "Items": [
                          "Food_Wildmeat_Cooked",
                          "Food_Wildmeat_Raw"
                        ]
                      }
                    ]
                  },
                  "BodyMotion": {
                    "Type": "Seek",
                    "SlowDownDistance": 4,
                    "StopDistance": 2,
                    "RelativeSpeed": 0.6
                  }
                },
                {
                  "$Comment": "Become alerted when player is close without food",
                  "Sensor": {
                    "Type": "Player",
                    "Range": 4,
                    "Filters": [
                      {
                        "Type": "Not",
                        "Filter": {
                          "Type": "ItemInHand",
                          "Items": [
                            "Food_Wildmeat_Cooked",
                            "Food_Wildmeat_Raw"
                          ]
                        }
                      }
                    ]
                  },
                  "Actions": [
                    {
                      "Type": "State",
                      "State": ".Alerted"
                    }
                  ]
                },
                {
                  "$Comment": "Wander around naturally",
                  "Sensor": {
                    "Type": "Any"
                  },
                  "BodyMotion": {
                    "Type": "Sequence",
                    "Looped": true,
                    "Motions": [
                      {
                        "Type": "Timer",
                        "Time": [4, 8],
                        "Motion": {
                          "Type": "WanderInCircle",
                          "Radius": 10,
                          "MaxHeadingChange": 60,
                          "RelativeSpeed": 0.4
                        }
                      },
                      {
                        "Type": "Timer",
                        "Time": [2, 5],
                        "Motion": {
                          "Type": "Nothing"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "$Comment": "Feeding state - eating animation with hearts",
              "Sensor": {
                "Type": "State",
                "State": ".Feeding"
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Animation": "Sit",
                  "Slot": "Action"
                },
                {
                  "Type": "PlaySound",
                  "SoundEventId": "SFX_Wolf_Sleep"
                },
                {
                  "Type": "SpawnParticles",
                  "Offset": [0, 0.5, 0],
                  "ParticleSystem": "Food_Eat"
                },
                {
                  "Type": "SpawnParticles",
                  "Offset": [0, 0.5, 0],
                  "ParticleSystem": "Hearts_Subtle"
                },
                {
                  "Type": "Timeout",
                  "Delay": [2, 2],
                  "Action": {
                    "Type": "State",
                    "State": ".Default"
                  }
                }
              ],
              "BodyMotion": {
                "Type": "Nothing"
              }
            },
            {
              "$Comment": "Rejection state - refuses interaction",
              "Sensor": {
                "Type": "State",
                "State": ".Rejection"
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "PlaySound",
                  "SoundEventId": "SFX_Wolf_Alerted"
                },
                {
                  "Type": "PlayAnimation",
                  "Animation": "Alerted",
                  "Slot": "Action"
                },
                {
                  "Type": "SpawnParticles",
                  "Offset": [0, 0.6, 0],
                  "ParticleSystem": "Angry"
                },
                {
                  "Type": "Timeout",
                  "Delay": [1.5, 1.5],
                  "Action": {
                    "Type": "State",
                    "State": ".Default"
                  }
                }
              ],
              "BodyMotion": {
                "Type": "Nothing"
              }
            },
            {
              "$Comment": "Alerted state - dog becomes alert when a player approaches",
              "Sensor": {
                "Type": "State",
                "State": ".Alerted"
              },
              "Instructions": [
                {
                  "$Comment": "Watch nearby player if present",
                  "Continue": true,
                  "Sensor": {
                    "Type": "Player",
                    "Range": 10
                  },
                  "HeadMotion": {
                    "Type": "Watch"
                  }
                },
                {
                  "ActionsBlocking": true,
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Alerted",
                      "Slot": "Status"
                    },
                    {
                      "Type": "PlaySound",
                      "SoundEventId": "SFX_Wolf_Alerted"
                    },
                    {
                      "Type": "Timeout",
                      "Delay": [2, 3],
                      "Action": {
                        "Type": "State",
                        "State": ".Default"
                      }
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Nothing"
                  }
                }
              ]
            },
            {
              "$Comment": "State setter declarations for validation - never executed",
              "Sensor": {
                "Type": "Flag",
                "Name": "_VALIDATION_ONLY_NEVER_SET"
              },
              "Actions": [
                {"Type": "State", "State": ".Default"},
                {"Type": "State", "State": ".Feeding"},
                {"Type": "State", "State": ".Rejection"},
                {"Type": "State", "State": ".Alerted"}
              ]
            }
          ]
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "Instructions": [
      {
        "$Comment": "Wild dog - show taming hint on mouse-over",
        "Continue": true,
        "Sensor": {
          "Type": "Not",
          "Sensor": {
            "Type": "DogTamed"
          }
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true,
            "Hint": "dogs_companion.interactions.hint.tame",
            "ShowPrompt": true
          }
        ]
      },
      {
        "$Comment": "Handle taming interaction",
        "Sensor": {
          "Type": "HasInteracted"
        },
        "Actions": [
          {
            "Type": "LockOnInteractionTarget"
          },
          {
            "Type": "DogInteractionWild"
          }
        ]
      }
    ]
  },
  "Parameters": {
    "AttractiveItems": {
      "Value": [
        "Food_Wildmeat_Cooked",
        "Food_Wildmeat_Raw"
      ],
      "Description": "Items that attract dogs and make them follow players"
    },
    "LovedItems": {
      "Value": [
        "Food_Wildmeat_Cooked",
        "Food_Wildmeat_Raw"
      ],
      "Description": "Items that dogs love and will befriend for"
    },
    "Appearance": {
      "Value": "DogsCompanion",
      "Description": "The dog's model appearance"
    },
    "NameTranslationKey": {
      "Value": "server.npcRoles.Dogs_Wild.name",
      "Description": "Translation key for dog name display"
    }
  }
}
