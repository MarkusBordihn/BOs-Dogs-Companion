              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "PlaySound",
                  "SoundEventId": "SFX_Wolf_Alerted"
                },
                {
                  "Type": "PlayAnimation",
                  "Animation": "Alerted",
