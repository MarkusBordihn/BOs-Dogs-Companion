                {
                  "Type": "PlayAnimation",
                  "Animation": "Bite",
                  "Slot": "Action"
                },
                {
                  "Type": "PlaySound",
                  "SoundEventId": "SFX_Wolf_Alerted"
                },
                {
                  "Type": "Timeout",
                  "Delay": [1.0, 1.0],
                  "Action": {
                    "Type": "State",
                    "State": ".Attacking"
                  }
                }
              ],
              "BodyMotion": {
                "Type": "Nothing"
              }
            },
            {
              "$Comment": "Attacking LockedTarget",
              "Sensor": {
                "Type": "State",
                "State": ".Attacking"
              },
              "Instructions": [
                {
                  "$Comment": "Timeout 30s, return to previous state",
                  "Sensor": {
                    "Type": "Any",
                    "Once": true
                  },
                  "Actions": [
                    {
                      "Type": "SpawnParticles",
                      "Offset": [0, 1.2, 0],
                      "ParticleSystem": "Alerted"
                    },
                    {
                      "Type": "PlaySound",
                      "SoundEventId": "SFX_Wolf_Run"
                    },
                    {
                      "Type": "Timeout",
                      "Delay": [30, 30],
                      "Action": {
                        "Type": "DogReturnToPreviousState"
                      }
                    }
                  ]
                },
                {
                  "$Comment": "Target killed, return immediately",
                  "Sensor": {
                    "Type": "Kill",
                    "TargetSlot": "LockedTarget"
                  },
                  "Actions": [
                    {
                      "Type": "DogReturnToPreviousState"
                    }
                  ]
                },
                {
                  "$Comment": "Safety: abort if target is owner",
                  "Sensor": {
                    "Type": "And",
                    "Sensors": [
                      {
                        "Type": "Target",
                        "TargetSlot": "LockedTarget"
                      },
                      {
                        "Type": "DogOwner"
                      }
                    ]
                  },
                  "Actions": [
                    {
                      "Type": "DogReturnToPreviousState"
                    }
                  ]
                },
                {
                  "$Comment": "Chase and attack target",
                  "Sensor": {
                    "Type": "Target",
                    "TargetSlot": "LockedTarget",
                    "Range": 20
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Run",
                      "Slot": "Action"
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Seek",
                    "SlowDownDistance": 4,
                    "StopDistance": 2,
                    "RelativeSpeed": 1.0
                  },
                  "HeadMotion": {
                    "Type": "Watch"
                  }
                },
                {
                  "$Comment": "Melee range",
                  "Sensor": {
                    "Type": "Target",
                    "TargetSlot": "LockedTarget",
                    "Range": 2.5
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Idle",
                      "Slot": "Action"
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Nothing"
                  }
                },
                {
                  "$Comment": "Target lost, return",
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "DogReturnToPreviousState"
                    }
                  ]
                }
              ]
