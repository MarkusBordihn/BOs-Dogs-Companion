                },
                {
                  "Type": "SpawnParticles",
                  "Offset": [0, 0.6, 0],
                  "ParticleSystem": "Angry"
                },
                {
                  "Type": "Timeout",
                  "Delay": [1.5, 1.5],
                  "Action": {
                    "Type": "State",
                    "State": ".Default"
                  }
                }
              ],
              "BodyMotion": {
                "Type": "Nothing"
              }
            },
            {
              "$Comment": "Striking, returns to Attacking",
              "Sensor": {
                "Type": "State",
