  "InteractionInstruction": {
    "Instructions": [
      {
        "$Comment": "Owner + whistle: whistle hint",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "DogOwner"
            },
            {
              "Type": "IsHoldingDogWhistle"
            }
          ]
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true,
            "Hint": "dogs_companion.interactions.hint.owner_whistle",
            "ShowPrompt": true
          }
        ]
      },
      {
        "$Comment": "Owner + food: feed hint",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "DogOwner"
            },
            {
              "Type": "IsHoldingDogFood"
            }
          ]
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true,
            "Hint": "dogs_companion.interactions.hint.owner_feed",
            "ShowPrompt": true
          }
        ]
      },
      {
        "$Comment": "Owner + empty hand: wheel hint",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "DogOwner"
            },
            {
              "Type": "IsHoldingDogEmptyHand"
            }
          ]
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true,
            "Hint": "dogs_companion.interactions.hint.owner_wheel",
            "ShowPrompt": true
          }
        ]
      },
      {
        "$Comment": "Owner + empty hand + returning: overrides wheel hint with item pickup hint",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "DogOwner"
            },
            {
              "Type": "IsHoldingDogEmptyHand"
            },
            {
              "Type": "State",
              "State": "Pet.Returning"
            }
          ]
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true,
            "Hint": "dogs_companion.interactions.hint.owner_return",
            "ShowPrompt": true
          }
        ]
      },
      {
        "$Comment": "Owner + other item: generic hint",
        "Continue": true,
        "Sensor": {
          "Type": "And",
