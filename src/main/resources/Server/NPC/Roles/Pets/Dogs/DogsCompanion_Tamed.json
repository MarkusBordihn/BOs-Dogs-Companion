{
  "Type": "Generic",
  "StartState": "Pet",
  "DefaultSubState": "Default",
  "Appearance": {
    "Compute": "Appearance"
  },
  "NameTranslationKey": {
    "Compute": "NameTranslationKey"
  },
  "DefaultNPCAttitude": "Friendly",
  "DefaultPlayerAttitude": "Friendly",
  "DeathAnimationTime": 1.5,
  "ApplySeparation": true,
  "SeparationDistance": 1,
  "SeparationWeight": 1,
  "KnockbackScale": 0.5,
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 8,
      "RunThreshold": 0.7,
      "RunThresholdRange": 0.2,
      "Gravity": 10,
      "MaxFallSpeed": 20,
      "Acceleration": 12,
      "DescentAnimationType": "Fall",
      "DescentSteepness": 2.5,
      "DescentBlending": 1,
      "JumpDescentSteepness": 8,
      "JumpHeight": 0.1,
      "MaxClimbHeight": 1
    }
  ],
  "MaxHealth": 60,
  "Instructions": [
    {
      "Instructions": [
        {
          "$Comment": "React to damage with hurt animation",
          "Continue": true,
          "Sensor": {
            "Type": "Damage"
          },
          "ActionsBlocking": true,
          "Actions": [
            {
              "Type": "PlayAnimation",
              "Animation": "Hurt",
              "Slot": "Status"
            },
            {
              "Type": "Timeout",
              "Delay": [0.5, 0.5]
            }
          ]
        },
        {
          "$Comment": "Dog is tamed - use substates for different behaviors",
          "Sensor": {
            "Type": "State",
            "State": "Pet"
          },
          "Instructions": [
            {
              "$Comment": "Sitting behavior - stays still in sitting pose",
              "Sensor": {
                "Type": "State",
                "State": ".Sitting"
              },
              "Instructions": [
                {
                  "$Comment": "Show particle when entering sitting state",
                  "Sensor": {
                    "Type": "Any",
                    "Once": true
                  },
                  "Actions": [
                    {
                      "Type": "SpawnParticles",
                      "Offset": [0, 1.2, 0],
                      "ParticleSystem": "Hearts_Subtle"
                    }
                  ]
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Sit",
                      "Slot": "Action"
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Nothing"
                  }
                }
              ]
            },
            {
              "$Comment": "Sleeping behavior - rests on ground",
              "Sensor": {
                "Type": "State",
                "State": ".Sleeping"
              },
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Animation": "Sleep",
                  "Slot": "Action"
                },
                {
                  "Type": "PlaySound",
                  "SoundEventId": "SFX_Wolf_Sleep"
                }
              ],
              "BodyMotion": {
                "Type": "Nothing"
              }
            },
            {
              "$Comment": "Playing behavior - playful movement, auto-returns to default after timeout",
              "Sensor": {
                "Type": "State",
                "State": ".Playing"
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Animation": "Jump",
                  "Slot": "Action"
                },
                {
                  "Type": "Timeout",
                  "Delay": [3, 6],
                  "Action": {
                    "Type": "State",
                    "State": ".Default"
                  }
                }
              ],
              "BodyMotion": {
                "Type": "WanderInCircle",
                "Radius": 3,
                "RelativeSpeed": 0.8
              }
            },
            {
              "$Comment": "Feeding state - eating animation with hearts",
              "Sensor": {
                "Type": "State",
                "State": ".Feeding"
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Animation": "Sit",
                  "Slot": "Action"
                },
                {
                  "Type": "PlaySound",
                  "SoundEventId": "SFX_Wolf_Sleep"
                },
                {
                  "Type": "SpawnParticles",
                  "Offset": [0, 0.5, 0],
                  "ParticleSystem": "Food_Eat"
                },
                {
                  "Type": "SpawnParticles",
                  "Offset": [0, 0.5, 0],
                  "ParticleSystem": "Hearts_Subtle"
                },
                {
                  "Type": "Timeout",
                  "Delay": [2, 2],
                  "Action": {
                    "Type": "State",
                    "State": ".Default"
                  }
                }
              ],
              "BodyMotion": {
                "Type": "Nothing"
              }
            },
            {
              "$Comment": "Rejection state - refuses interaction",
              "Sensor": {
                "Type": "State",
                "State": ".Rejection"
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "PlaySound",
                  "SoundEventId": "SFX_Wolf_Alerted"
                },
                {
                  "Type": "PlayAnimation",
                  "Animation": "Alerted",
                  "Slot": "Action"
                },
                {
                  "Type": "SpawnParticles",
                  "Offset": [0, 0.6, 0],
                  "ParticleSystem": "Angry"
                },
                {
                  "Type": "Timeout",
                  "Delay": [1.5, 1.5],
                  "Action": {
                    "Type": "State",
                    "State": ".Default"
                  }
                }
              ],
              "BodyMotion": {
                "Type": "Nothing"
              }
            },
            {
              "$Comment": "Striking behavior - brief strike animation and sound when damage is applied",
              "Sensor": {
                "Type": "State",
                "State": ".Striking"
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "SpawnParticles",
                  "Offset": [0.0, 0.8, -0.7],
                  "ParticleSystem": "Impact_Blade_01"
                },
                {
                  "Type": "PlayAnimation",
                  "Animation": "Bite",
                  "Slot": "Action"
                },
                {
                  "Type": "PlaySound",
                  "SoundEventId": "SFX_Wolf_Alerted"
                },
                {
                  "Type": "Timeout",
                  "Delay": [1.0, 1.0],
                  "Action": {
                    "Type": "State",
                    "State": ".Attacking"
                  }
                }
              ],
              "BodyMotion": {
                "Type": "Nothing"
              }
            },
            {
              "$Comment": "Attacking behavior - attacks commanded target",
              "Sensor": {
                "Type": "State",
                "State": ".Attacking"
              },
              "Instructions": [
                {
                  "$Comment": "Attack timeout - return to previous state after 30 seconds",
                  "Sensor": {
                    "Type": "Any",
                    "Once": true
                  },
                  "Actions": [
                    {
                      "Type": "SpawnParticles",
                      "Offset": [0, 1.2, 0],
                      "ParticleSystem": "Alerted"
                    },
                    {
                      "Type": "Timeout",
                      "Delay": [30, 30],
                      "Action": {
                        "Type": "DogReturnToPreviousState"
                      }
                    }
                  ]
                },
                {
                  "$Comment": "Chase and attack target",
                  "Sensor": {
                    "Type": "Target",
                    "TargetSlot": "LockedTarget",
                    "Range": 20
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Run",
                      "Slot": "Action"
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Seek",
                    "SlowDownDistance": 4,
                    "StopDistance": 2,
                    "RelativeSpeed": 1.0
                  },
                  "HeadMotion": {
                    "Type": "Watch"
                  }
                },
                {
                  "$Comment": "Attack when in melee range - plays attack animation",
                  "Sensor": {
                    "Type": "Target",
                    "TargetSlot": "LockedTarget",
                    "Range": 2.5
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Idle",
                      "Slot": "Action"
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Nothing"
                  }
                },
                {
                  "$Comment": "Target lost or dead - return to previous state",
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "DogReturnToPreviousState"
                    }
                  ]
                }
              ]
            },
            {
              "$Comment": "Waiting behavior - stands still and watches",
              "Sensor": {
                "Type": "State",
                "State": ".Waiting"
              },
              "Instructions": [
                {
                  "$Comment": "Show particle when entering waiting state",
                  "Sensor": {
                    "Type": "Any",
                    "Once": true
                  },
                  "Actions": [
                    {
                      "Type": "SpawnParticles",
                      "Offset": [0, 1.2, 0],
                      "ParticleSystem": "Hearts"
                    }
                  ]
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Idle",
                      "Slot": "Action"
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Nothing"
                  }
                }
              ]
            },
            {
              "$Comment": "Wandering behavior - walks around freely",
              "Sensor": {
                "Type": "State",
                "State": ".Wandering"
              },
              "Instructions": [
                {
                  "$Comment": "Reset animation first",
                  "Sensor": {
                    "Type": "Any",
                    "Once": true
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Idle",
                      "Slot": "Action"
                    }
                  ]
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Idle",
                      "Slot": "Action"
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Sequence",
                    "Looped": true,
                    "Motions": [
                      {
                        "Type": "Timer",
                        "Time": [3, 6],
                        "Motion": {
                          "Type": "WanderInCircle",
                          "Radius": 10,
                          "MaxHeadingChange": 60,
                          "RelativeSpeed": 0.5
                        }
                      },
                      {
                        "Type": "Timer",
                        "Time": [2, 4],
                        "Motion": {
                          "Type": "Nothing"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "$Comment": "Searching behavior - dog searches and tracks around the area",
              "Sensor": {
                "Type": "State",
                "State": ".Searching"
              },
              "Instructions": [
                {
                  "$Comment": "Show particle when entering searching state",
                  "Sensor": {
                    "Type": "Any",
                    "Once": true
                  },
                  "Actions": [
                    {
                      "Type": "SpawnParticles",
                      "Offset": [0, 1.2, 0],
                      "ParticleSystem": "Question"
                    },
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Idle",
                      "Slot": "Action"
                    }
                  ]
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Idle",
                      "Slot": "Action"
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Sequence",
                    "Looped": true,
                    "Motions": [
                      {
                        "Type": "Timer",
                        "Time": [2, 4],
                        "Motion": {
                          "Type": "WanderInCircle",
                          "Radius": 8,
                          "MaxHeadingChange": 90,
                          "RelativeSpeed": 0.6
                        }
                      },
                      {
                        "Type": "Timer",
                        "Time": [1, 2],
                        "Motion": {
                          "Type": "Nothing"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "$Comment": "Defense mode - follows owner and auto-attacks when owner is damaged",
              "Sensor": {
                "Type": "State",
                "State": ".Defense"
              },
              "Instructions": [
                {
                  "$Comment": "Clear stale animations and alert when entering defense mode",
                  "Sensor": {
                    "Type": "Any",
                    "Once": true
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Idle",
                      "Slot": "Action"
                    },
                    {
                      "Type": "SpawnParticles",
                      "Offset": [0, 1.2, 0],
                      "ParticleSystem": "Question"
                    },
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Alerted",
                      "Slot": "Status"
                    },
                    {
                      "Type": "PlaySound",
                      "SoundEventId": "SFX_Wolf_Alerted"
                    }
                  ]
                },
                {
                  "$Comment": "Follow owner player within range - motion controller handles animations",
                  "Sensor": {
                    "Type": "Player",
                    "Range": 18,
                    "LockOnTarget": true
                  },
                  "BodyMotion": {
                    "Type": "Seek",
                    "SlowDownDistance": 10,
                    "StopDistance": 3,
                    "RelativeSpeed": 0.9
                  },
                  "HeadMotion": {
                    "Type": "Watch"
                  }
                },
                {
                  "$Comment": "Teleport to player if too far away",
                  "Sensor": {
                    "Type": "Target"
                  },
                  "BodyMotion": {
                    "Type": "Teleport"
                  }
                }
              ]
            },
            {
              "$Comment": "Offense mode - follows owner and assists when owner attacks",
              "Sensor": {
                "Type": "State",
                "State": ".Offense"
              },
              "Instructions": [
                {
                  "$Comment": "Clear stale animations and alert when entering offense mode",
                  "Sensor": {
                    "Type": "Any",
                    "Once": true
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Idle",
                      "Slot": "Action"
                    },
                    {
                      "Type": "SpawnParticles",
                      "Offset": [0, 1.2, 0],
                      "ParticleSystem": "Alerted"
                    },
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Alerted",
                      "Slot": "Status"
                    },
                    {
                      "Type": "PlaySound",
                      "SoundEventId": "SFX_Wolf_Alerted"
                    }
                  ]
                },
                {
                  "$Comment": "Follow owner player within range - motion controller handles animations",
                  "Sensor": {
                    "Type": "Player",
                    "Range": 18,
                    "LockOnTarget": true
                  },
                  "BodyMotion": {
                    "Type": "Seek",
                    "SlowDownDistance": 10,
                    "StopDistance": 3,
                    "RelativeSpeed": 0.9
                  },
                  "HeadMotion": {
                    "Type": "Watch"
                  }
                },
                {
                  "$Comment": "Teleport to player if too far away",
                  "Sensor": {
                    "Type": "Target"
                  },
                  "BodyMotion": {
                    "Type": "Teleport"
                  }
                }
              ]
            },
            {
              "$Comment": "Default following behavior - follows owner with natural idle variations",
              "Sensor": {
                "Type": "State",
                "State": ".Default"
              },
              "Instructions": [
                {
                  "$Comment": "Clear stale animations when entering default mode",
                  "Sensor": {
                    "Type": "Any",
                    "Once": true
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Idle",
                      "Slot": "Action"
                    }
                  ]
                },
                {
                  "$Comment": "Follow owner when far away - motion controller handles walk/run transitions",
                  "Sensor": {
                    "Type": "Player",
                    "Range": 18,
                    "MinRange": 5,
                    "LockOnTarget": true
                  },
                  "BodyMotion": {
                    "Type": "Seek",
                    "SlowDownDistance": 10,
                    "StopDistance": 3,
                    "RelativeSpeed": 0.9
                  },
                  "HeadMotion": {
                    "Type": "Watch"
                  }
                },
                {
                  "$Comment": "Natural idle behavior when close to owner - random variations",
                  "Sensor": {
                    "Type": "Player",
                    "Range": 5,
                    "LockOnTarget": true
                  },
                  "BodyMotion": {
                    "Type": "Sequence",
                    "Looped": true,
                    "Motions": [
                      {
                        "$Comment": "Stand idle near owner for a while",
                        "Type": "Timer",
                        "Time": [3, 7],
                        "Motion": {
                          "Type": "Nothing"
                        }
                      },
                      {
                        "$Comment": "Short wander - sniff around",
                        "Type": "Timer",
                        "Time": [1, 3],
                        "Motion": {
                          "Type": "WanderInCircle",
                          "Radius": 3,
                          "MaxHeadingChange": 45,
                          "RelativeSpeed": 0.2
                        }
                      },
                      {
                        "$Comment": "Pause again",
                        "Type": "Timer",
                        "Time": [2, 5],
                        "Motion": {
                          "Type": "Nothing"
                        }
                      },
                      {
                        "$Comment": "Another short wander in different direction",
                        "Type": "Timer",
                        "Time": [1, 2],
                        "Motion": {
                          "Type": "WanderInCircle",
                          "Radius": 2,
                          "MaxHeadingChange": 90,
                          "RelativeSpeed": 0.15
                        }
                      }
                    ]
                  },
                  "HeadMotion": {
                    "Type": "Watch"
                  }
                },
                {
                  "$Comment": "Teleport to player if too far away (outside seek range)",
                  "Sensor": {
                    "Type": "Target"
                  },
                  "BodyMotion": {
                    "Type": "Teleport"
                  }
                }
              ]
            },
            {
              "$Comment": "State setter declarations for validation - never executed",
              "Sensor": {
                "Type": "Flag",
                "Name": "_VALIDATION_ONLY_NEVER_SET"
              },
              "Actions": [
                {"Type": "State", "State": ".Attacking"},
                {"Type": "State", "State": ".Default"},
                {"Type": "State", "State": ".Defense"},
                {"Type": "State", "State": ".Feeding"},
                {"Type": "State", "State": ".Offense"},
                {"Type": "State", "State": ".Playing"},
                {"Type": "State", "State": ".Rejection"},
                {"Type": "State", "State": ".Searching"},
                {"Type": "State", "State": ".Sitting"},
                {"Type": "State", "State": ".Sleeping"},
                {"Type": "State", "State": ".Striking"},
                {"Type": "State", "State": ".Waiting"},
                {"Type": "State", "State": ".Wandering"}
              ]
            }
          ]
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "Instructions": [
      {
        "$Comment": "Tamed dog + Owner - show owner interaction hint",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "DogTamed"
            },
            {
              "Type": "DogOwner"
            }
          ]
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true,
            "Hint": "dogs_companion.interactions.hint.owner",
            "ShowPrompt": true
          }
        ]
      },
      {
        "$Comment": "Tamed dog + Stranger - show stranger interaction hint (cannot interact)",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "DogTamed"
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "DogOwner"
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true,
            "Hint": "dogs_companion.interactions.hint.stranger",
            "ShowPrompt": true
          },
          {
            "Type": "DogInteractionStranger"
          }
        ]
      },
      {
        "$Comment": "Handle owner interactions",
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "HasInteracted"
            },
            {
              "Type": "DogOwner"
            }
          ]
        },
        "Actions": [
          {
            "Type": "LockOnInteractionTarget"
          },
          {
            "Type": "DogCycleState"
          }
        ]
      }
    ]
  },
  "IsMemory": true,
  "MemoriesCategory": "Dogs",
  "Parameters": {
    "NameTranslationKey": {
      "Value": "server.npcRoles.DogsCompanion_Tamed.name",
      "Description": "Translation key for dog name display"
    },
    "Appearance": {
      "Value": "DogsCompanion_Tamed",
      "Description": "The dog's model appearance"
    }
  }
}
