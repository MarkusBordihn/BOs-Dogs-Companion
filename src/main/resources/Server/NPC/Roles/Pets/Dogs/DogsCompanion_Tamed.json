  "MaxHealth": 60,
  "Instructions": [
    {
      "Instructions": [
        {
          "$Comment": "React to damage with hurt animation",
          "Continue": true,
          "Sensor": {
            "Type": "Damage"
          },
          "ActionsBlocking": true,
          "Actions": [
            {
              "Type": "PlayAnimation",
              "Animation": "Hurt",
              "Slot": "Status"
            },
            {
              "Type": "PlaySound",
              "SoundEventId": "SFX_Wolf_Hurt"
            },
            {
              "Type": "Timeout",
              "Delay": [0.5, 0.5]
            }
          ]
        },
        {
          "$Comment": "Mood particles, runs alongside the Pet substates without claiming motion",
          "Continue": true,
          "Sensor": {
            "Type": "State",
            "State": "Pet"
          },
          "Actions": [
            {
              "Type": "DogMoodParticles"
            }
          ]
        },
        {
          "$Comment": "Pet substates",
          "Sensor": {
            "Type": "State",
            "State": "Pet"
          },
          "Instructions": [
            {
              "$Comment": "Sitting",
              "Sensor": {
                "Type": "State",
                "State": ".Sitting"
              },
              "Instructions": [
                {
                  "$Comment": "Enter particle",
                  "Sensor": {
                    "Type": "Any",
                    "Once": true
                  },
                  "Actions": [
                    {
                      "Type": "SpawnParticles",
                      "Offset": [0, 1.2, 0],
                      "ParticleSystem": "Hearts_Subtle"
                    }
                  ]
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Sit",
                      "Slot": "Action"
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Nothing"
                  }
                }
              ]
            },
            {
              "$Comment": "Sleeping",
              "Sensor": {
                "Type": "State",
                "State": ".Sleeping"
              },
              "Instructions": [
                {
                  "$Comment": "Enter particle and sound",
                  "Sensor": {
                    "Type": "Any",
                    "Once": true
                  },
                  "Actions": [
                    {
                      "Type": "SpawnParticles",
                      "Offset": [0, 1.2, 0],
                      "ParticleSystem": "Sleepy"
                    },
                    {
                      "Type": "PlaySound",
                      "SoundEventId": "SFX_Wolf_Sleep"
                    }
                  ]
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Sleep",
                      "Slot": "Action"
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Nothing"
                  }
                }
              ]
            },
            {
              "$Comment": "Playing, returns to default after timeout",
              "Sensor": {
                "Type": "State",
                "State": ".Playing"
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Animation": "Jump",
                  "Slot": "Action"
                },
                {
                  "Type": "Timeout",
                  "Delay": [3, 6],
                  "Action": {
                    "Type": "State",
                    "State": ".Default"
                  }
                }
              ],
              "BodyMotion": {
                "Type": "WanderInCircle",
                "Radius": 3,
                "RelativeSpeed": 0.8
              }
            },
            {
              "$Comment": "Feeding",
              "Sensor": {
                "Type": "State",
                "State": ".Feeding"
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Animation": "Sit",
                  "Slot": "Action"
                },
                {
                  "Type": "PlaySound",
                  "SoundEventId": "SFX_Wolf_Sleep"
                },
                {
                  "Type": "SpawnParticles",
                  "Offset": [0, 0.5, 0],
                  "ParticleSystem": "Food_Eat"
                },
                {
                  "Type": "SpawnParticles",
                  "Offset": [0, 0.5, 0],
                  "ParticleSystem": "Hearts_Subtle"
                },
                {
                  "Type": "SpawnParticles",
                  "Offset": [0, 0.5, 0],
                  "ParticleSystem": "Effect_Heal"
                },
                {
                  "Type": "Timeout",
                  "Delay": [2, 2],
                  "Action": {
                    "Type": "State",
                    "State": ".Default"
                  }
                }
              ],
              "BodyMotion": {
                "Type": "Nothing"
              }
            },
            {
              "$Comment": "Rejection",
