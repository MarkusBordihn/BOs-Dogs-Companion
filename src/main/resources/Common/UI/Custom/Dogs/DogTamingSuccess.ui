$Common = "../Common.ui";

$Common.@PageOverlay {
  LayoutMode: Middle;
  $Common.@DecoratedContainer #DogTamingSuccessRoot {
    Anchor: (Width: 520, Height: 380);

    #Title {
      $Common.@Title #DogTamingSuccessTitle {
        @Text = "Dog Tamed!";
      }
    }

    #Content {
      LayoutMode: Top;
      Label #DogTamingSuccessCongrats {
        Anchor: (Height: 26, Bottom: 8);
        Text: "Congratulations!";
        Style: (
          FontSize: 15,
          RenderBold: true,
          TextColor: #f5d76e,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        );
      }

      Label #DogTamingSuccessBreed {
        Anchor: (Height: 26, Bottom: 16);
        Text: "";
        Style: (
          FontSize: 18,
          RenderBold: true,
          TextColor: #ffffff,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        );
      }

      Label #DogTamingSuccessNameLabel {
        Anchor: (Height: 22, Bottom: 4);
        Text: "Give your dog a name:";
        Style: (
          FontSize: 14,
          TextColor: #dbe4e7,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        );
      }

      TextField #DogTamingSuccessNameField {
        Style: $Common.@DefaultInputFieldStyle;
        PlaceholderStyle: $Common.@DefaultInputFieldPlaceholderStyle;
        Background: $Common.@InputBoxBackground;
        Anchor: (Height: 44, Bottom: 12);
        Padding: (Horizontal: 10);
        PlaceholderText: "Dog name";
        MaxLength: 32;
      }

      Group {
        Anchor: (Height: 24);
      }

      Label #DogTamingSuccessTip1 {
        Anchor: (Height: 20, Bottom: 2);
        Text: "Press F with an empty hand to open the interaction menu";
        Style: (
          FontSize: 13,
          TextColor: #888888,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        );
      }

      Label #DogTamingSuccessTip2 {
        Anchor: (Height: 20, Bottom: 2);
        Text: "Press F while holding food to feed and heal your dog";
        Style: (
          FontSize: 13,
          TextColor: #888888,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        );
      }

      Label #DogTamingSuccessTip3 {
        Anchor: (Height: 20, Bottom: 12);
        Text: "Use /dog for commands like sit, follow, sleep and more";
        Style: (
          FontSize: 13,
          TextColor: #888888,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        );
      }

      Group {
        LayoutMode: Right;
        $Common.@SmallTertiaryTextButton #DogTamingSuccessConfirmButton {
          @Sounds = $Common.@ButtonSounds;
          @Text = "Confirm";
          @Anchor = (Right: 10, MinWidth: 140);
        }
      }
    }
  }
}
$Common.@BackButton {}
